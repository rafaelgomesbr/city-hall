# Artefatos de build e empacotamento
dist/
node_modules/
.env
.env.*
!.env.example

# Credenciais de publicacao do aplicativo de campo.
dc360/apps/campo/segredos/

# Chave de push da Apple. Manda notificacao para qualquer app do time:
# se vazar, alguem escreve na tela de bloqueio de um agente de Defesa Civil.
*.p8
*.mobileprovision

# Conta de servico do Firebase. Autoriza mandar notificacao para qualquer
# aparelho do projeto: e segredo de verdade, ao contrario do google-services.json.
*firebase-adminsdk*.json
*-conta-servico.json

# Handoffs de sessao do Claude Code: efemeros (D-30). O que for duravel
# vira skill em .claude/skills/ ou documento em docs/.
.claude/handoffs/

# PDF dos relatorios executivos: artefato, fora do git (D-30). A fonte
# HTML, o JSON da coleta e o INDEX.md com o SHA-256 ficam versionados.
docs/relatorios-v2/**/*.pdf
