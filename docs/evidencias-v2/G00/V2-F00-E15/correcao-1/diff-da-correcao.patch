+
+  it("a Ana entra de novo e reencontra a vistoria como deixou", async () => {
+    await plantaoDaAna();
+    await abrirATelaLogada();
+    await terminarASessao();
+    await act(async () => { fireEvent.press(botaoDeEntrarDeNovo()); });
+    await act(async () => {});
