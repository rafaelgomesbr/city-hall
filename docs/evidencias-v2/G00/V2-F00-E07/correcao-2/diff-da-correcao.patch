+// ---------------------------------------------------------------------------
+// 2. Postgres de verdade: a trava comum.
+// ---------------------------------------------------------------------------
+
+describe.skipIf(!URL_DE_PROVA)("Renovação e encerramento em Postgres real: a trava comum por pessoa", () => {
