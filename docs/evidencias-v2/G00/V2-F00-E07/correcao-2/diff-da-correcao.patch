+    });
+    const chaveDoUsuario = await chaveDe(usuario);
+    const chaveDoOutro = await chaveDe(outro);
+    // As duas pessoas com sessão de pé (o teste anterior encerrou as da primeira).
+    await abrir("sessao-do-usuario", null, usuario);
