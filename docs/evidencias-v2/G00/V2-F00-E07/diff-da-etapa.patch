+  }
+
+  it("no prazo, a senha provisória troca", async () => {
+    const temporaria = await sorteada();
+    try {
+      const s = await entrar(EMAIL_HELENA, temporaria);
+      const troca = await app.inject({
+        method: "POST", url: "/auth/trocar-senha", headers: com(s.acesso),
