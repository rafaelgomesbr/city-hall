+      - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
+    const reservaDoX = campo.type === "search" ? 24 : 0;
+    return { cabe: texto + reservaDoX <= area + 0.5, texto, area, reservaDoX, exemplo: campo.placeholder };
+  }, seletor);
