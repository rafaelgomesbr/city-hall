+        () => ok(`a ${rotulo(l, a)}, "${nome}": depois do erro, o Esc fecha a janela`, true),
+        () => ok(`a ${rotulo(l, a)}, "${nome}": depois do erro, o Esc fecha a janela`, false, "(a janela continua aberta)"),
+      );
+      await ctx.close();
+    }
+  }
+}
