+        if (rota.request().method() === "OPTIONS") return rota.fulfill({ status: 204, headers: CORS });
+        if (atraso) await new Promise((r) => setTimeout(r, atraso));
+        return rota.fulfill({ status: 500, headers: { ...CORS, "content-type": "application/json" },
