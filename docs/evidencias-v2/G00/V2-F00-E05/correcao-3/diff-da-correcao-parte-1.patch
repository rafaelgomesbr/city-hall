+        while (ts.isPropertyAccessExpression(e)) e = e.expression;
+        if (!ts.isIdentifier(e)) problema(t, `\`extends\` de uma expressão (\`${t.getText(sf)}\`): a varredura não sabe de que classe é`);
+      }
+    }
+
     ts.forEachChild(no, visitar);
   };
   visitar(sf);
