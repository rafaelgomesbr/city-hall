+jest.mock("../ui/Assinatura", () => ({ Assinatura: () => null }));
+jest.mock("../ui/retornoTatil", () => ({ retornoTatil: jest.fn() }));
+jest.mock("../dados/api", () => ({ enderecoDaApi: () => "https://api.exemplo" }));
