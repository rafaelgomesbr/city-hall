+import type { MotivoDeSessao } from "@dc360/campo";
+import type { Pendencia } from "../dados/api";
+import { frasesDaPausa } from "../dados/pausa-da-fila";
+import TelaDeVistoria from "../app/(agente)/vistoria/[id]";
+
+/* ============================================================
+   O aparelho, de mentira
+   ============================================================ */
+
