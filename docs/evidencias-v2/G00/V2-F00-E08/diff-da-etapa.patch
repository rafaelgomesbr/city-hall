+      if (!c) throw new Error(`a semente não tem ${papel}`);
+      return {
+        organizacaoId: c.organizacao_id,
+        organizacaoNome: c.organizacao_nome,
+        municipio: c.municipio,
+        uf: c.uf,
+        usuarioId: c.usuario_id,
+        usuarioNome: c.usuario_nome,
+        papel: c.papel,
+      };
+    };
