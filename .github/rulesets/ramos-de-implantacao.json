{
  "name": "ramos de implantação (só o workflow move)",
  "target": "branch",
  "source_type": "Repository",
  "source": "rafaelgomesbr/city-hall",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/producao", "refs/heads/homologacao"],
      "exclude": []
