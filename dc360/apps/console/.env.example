# =====================================================================
# Console do fornecedor (ADR 0008). Processo SEPARADO da API.
#
# Todas as variaveis tem prefixo CONSOLE_ de proposito. Com JWT_SEGREDO
# valendo para os dois, bastaria um painel de implantacao com variaveis de
# projeto compartilhadas para os dois processos passarem a assinar com a
# mesma chave, e a separacao viraria uma convencao que ninguem confere.
#
# Ainda assim o segredo NAO e a separacao: a separacao e a plateia do token
# (aud=dc360-console), e ela recusa o token do produto mesmo quando os dois
# segredos sao iguais. Ver apps/console/test/plateia-nao-atravessa.test.ts.
# =====================================================================

NODE_ENV=development
CONSOLE_PORT=3344

# 127.0.0.1 so aceita conexao da propria maquina, que e o certo no computador de
# quem desenvolve. DENTRO DE UM CONTEINER e o oposto: o loopback e o do proprio
# conteiner, entao o processo sobe inteiro, escreve no log que esta no ar, e o
# balanceador bate na porta publicada sem ninguem atender. Nao ha erro para
# procurar, ha um aplicativo de pe que nao responde.
#
# Em producao a partida RECUSA um endereco de loopback, para o defeito nao ficar
# mudo. O valor certo la e 0.0.0.0, e ele ja esta declarado em fly.console.toml.
CONSOLE_HOST=127.0.0.1

# Assina a sessao do console. Sem valor padrao, em ambiente NENHUM: aqui nao
# existe modo "so para experimentar", porque qualquer console de pe e uma tela
# que mostra numeros de mais de um municipio.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CONSOLE_JWT_SEGREDO=

# Cifra o segredo do segundo fator dos operadores (AES-256-GCM, 32 bytes em
# base64). SEPARADA da SEGUNDO_FATOR_CHAVE do produto.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CONSOLE_SEGUNDO_FATOR_CHAVE=

# Os operadores, em JSON. Cada um precisa de `segundoFator`: operador sem ele e
# operador que entraria so com senha, e a partida recusa.
#   CONSOLE_SEGUNDO_FATOR_CHAVE=... npm run provisionar --workspace @dc360/console -- --email pessoa@fornecedor.com.br
#
# A ARMADILHA DAS ASPAS, que so aparece na hora de implantar:
#
#   fly secrets set CONSOLE_OPERADORES="[...]"     <- NAO faca isto
#
# Com aspas DUPLAS, quem le o valor primeiro e o SHELL, e ele expande `$131072`,
# `$8` e `$1` do hash de senha para vazio antes de o `fly` receber qualquer
# coisa. O que sobe e `scrypt$$$sal$hash`. Dai em diante tudo continua parecendo
# certo: o JSON e valido, o esquema passa, o envelope do segundo fator abre (ele
# e base64 e nao tem `$`), e o processo sobe normal. So a senha certa e recusada,
# para sempre, sem uma linha de log.
#
# Em producao os segredos entram por ARQUIVO, e nunca por linha de comando:
#   fly secrets import -a defesa-civil-console < segredos-do-console.env
#
# O mesmo cuidado vale para CONSOLE_JWT_SEGREDO e CONSOLE_SEGUNDO_FATOR_CHAVE,
# que sao base64 e podem ter `+`, `/` e `=`. Ver docs/IMPLANTACAO.md secao 6.
#
# Desde 15/09/2026 a partida recusa hash que nao tenha as seis partes de
# `scrypt$N$r$p$sal$hash`, dizendo que a causa provavel foram as aspas. Com
# isso, um deploy feito pelo caminho errado FALHA em vez de subir quebrado.
CONSOLE_OPERADORES=

# A conexao, com um papel de login membro de dc360_console (sem concessao em
# tabela de negocio nenhuma). NUNCA a DATABASE_URL da API.
#
# O console CADASTRA prefeitura (emenda de 14/09/2026 da ADR 0008) e mesmo
# assim este papel continua sem INSERT, UPDATE ou DELETE em tabela nenhuma: o
# que a migracao 036 concedeu a dc360_console foi EXECUTE em UMA funcao
# SECURITY DEFINER, que cria municipio e primeiro administrador numa transacao
# e devolve dois identificadores. Nada a mudar aqui por causa disso.
#   CREATE ROLE dc360_console_login LOGIN PASSWORD '...' NOSUPERUSER;
#   GRANT dc360_console TO dc360_console_login WITH SET TRUE;
#
# O PAPEL PRECISA SER OUTRO, e isso e o erro mais facil de cometer aqui:
# `dc360_console` nasceu NOLOGIN na migracao 023, de proposito, entao ele nao
# serve de usuario de string de conexao. E o `WITH SET TRUE` nao e enfeite: toda
# transacao do console emite `SET LOCAL ROLE dc360_console` (ver banco.ts), e sem
# ele o `SET ROLE` e recusado e TODA consulta falha.
#
# Em producao ela e obrigatoria e precisa terminar em ?sslmode=verify-full, e a
# partida recusa sem isso: sem verificacao do certificado a conexao com o banco
# de todos os municipios sobe cifrada e NAO autenticada.
CONSOLE_DATABASE_URL=

# So no desenvolvimento: onde o Postgres em WebAssembly guarda os arquivos.
# Sem isto o console de desenvolvimento nasce vazio a cada reinicio, e vazio
# aqui e identico a "todos os municipios pararam de escrever".
CONSOLE_BANCO_LOCAL=
