{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // Declarado na mão porque o TypeScript 6 não varre mais `node_modules/@types`
    // sozinho. Sem esta linha, os arquivos de teste não enxergam `describe`,
    // `it` nem `expect`, e o `typecheck` reprova por motivo que não é defeito.
    //
    // O `expo prebuild` reescreve este arquivo e apaga comentários. Se esta
    // linha sumir de novo, foi ele.
    "types": ["jest"]
  },
  // `.expo/types` e `expo-env.d.ts` são gerados: trazem as rotas tipadas do
  // expo-router e as declarações de módulo de imagem e de fonte.
  "include": ["src", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
