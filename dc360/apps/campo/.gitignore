# Dependências e artefatos de build do aplicativo.
node_modules/
.expo/
dist/
web-build/

# Projeto nativo gerado por `expo prebuild`, que roda dentro de `expo run:android`
# e `expo run:ios`.
#
# Ele NÃO é versionado de propósito. A fonte de verdade da configuração nativa é
# `app.config.ts`: nome, ícone, permissões em português, microfone bloqueado,
# `allowBackup` desligado. Versionar `android/` cria uma segunda cópia dessas
# decisões, e a cópia sai de sincronia em silêncio: alguém muda o texto da
# permissão no `app.config.ts`, o build usa o que está no arquivo nativo antigo,
# e o aparelho pede câmera com a frase genérica.
#
# Para regenerar: `npx expo prebuild --clean`.
android/
ios/

# Credenciais de publicação. NUNCA versionar.
#
# A chave de conta de serviço do Play Console dá poder de publicar em nome da
# organização, e a da Apple, de assinar binário. Commitar qualquer uma delas
# significa rotacionar as duas contas.
segredos/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# `google-services.json` PRECISA ser rastreado, e a linha que o ignorava foi
# removida em 09/09/2026 depois de ela quase quebrar o build na nuvem.
#
# Dois motivos, e o primeiro basta:
#
# 1. O EAS constrói a partir do git. Arquivo ignorado nao chega no worker, e o
#    build do Android falha na hora de resolver o Firebase, com uma mensagem
#    que nao aponta para a causa.
# 2. Ele nao e segredo. Numero do projeto, id do app e chave de API do Android
#    saem de qualquer APK publicado com um descompactador. O que protege essa
#    chave e a restricao por pacote e por API no Google Cloud, nunca o sigilo
#    do arquivo.
#
# O que continua fora do git, e ai sim e segredo de verdade: a chave .p8 da
# Apple (linha acima), o keystore de assinatura do Android, e a conta de
# servico do Firebase que o EAS usa para falar com o FCM.
GoogleService-Info.plist

# Ambiente local.
.env
.env.local

