{
  "name": "@dc360/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "provisionar": "tsx src/provisionar.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:env": "node --env-file=.env dist/index.js",
    "migrar:env": "node --env-file=.env ../../db/dist/cli.js",
    "provisionar:env": "npx tsx --env-file=.env src/provisionar.ts",
    "armazenamento": "tsx src/armazenamento/cli.ts"
  },
  "dependencies": {
    "@dc360/db": "*",
    "@dc360/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@dc360/campo": "*",
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
