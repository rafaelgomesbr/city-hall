# Ambiente da API do DC360.
#
# Copie para `.env` e preencha. Nada aqui tem valor de verdade: é modelo.
#
# A regra que governa este arquivo está em `src/config.ts`, e ela é dura de
# propósito: em produção o processo NÃO SOBE se faltar o que importa. Um
# servidor que sobe com chave padrão é pior que um servidor que não sobe,
# porque parece funcionar.

# ---------------------------------------------------------------------------
# Básico
# ---------------------------------------------------------------------------

# development | test | production. Em produção as exigências abaixo passam a
# valer, e várias delas derrubam a partida se estiverem erradas.
NODE_ENV=development

PORT=3333
# 127.0.0.1 só aceita conexão da própria máquina. Atrás de um proxy reverso é
# o que se quer; sem proxy, e para aceitar de fora, use 0.0.0.0.
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------

# Obrigatória em produção. Ausente em desenvolvimento, e aí a API sobe um
# Postgres em WebAssembly, efêmero, que some junto com o processo.
#
# O usuário desta URL é o DONO das tabelas, e é ele que aplica migração e
# provisiona município. A aplicação não trabalha com ele: toda requisição
# assume o papel `dc360_app`, que não é superusuário e não é dono, porque
# dono e superusuário ignoram Row Level Security.
# DATABASE_URL=postgres://dc360_dono:senha@localhost:5432/dc360

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------

# Obrigatória em produção, mínimo de 32 bytes. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Trocar este segredo invalida todos os tokens de acesso em circulação, o que
# derruba todo mundo. É o botão de emergência para vazamento de chave.
# JWT_SEGREDO=

# Vida do token de acesso, em minutos. Curto de propósito: quem for desligado
# perde o acesso em no máximo esse tempo, mesmo sem ninguém revogar nada.
ACESSO_MINUTOS=15

# Vida do token de renovação, em dias. Ele é rotativo: cada uso gera outro, e
# reúso de token já gasto derruba a sessão inteira, porque reúso é sintoma de
# roubo.
RENOVACAO_DIAS=14

# Falhas de senha antes de bloquear a conta, e por quantos minutos.
MAX_FALHAS_LOGIN=5
BLOQUEIO_MINUTOS=15

# Tentativas de login por endereço de origem, na janela de cinco minutos. Este
# é o limite que atrapalha ataque de lista de senhas; o de cima protege a
# conta específica.
LOGIN_POR_IP=10

# Validade do link de redefinição de senha, em minutos.
RECUPERACAO_MINUTOS=30

# ---------------------------------------------------------------------------
# Endereços
# ---------------------------------------------------------------------------
#
# Os três abaixo têm padrão de máquina local, e em produção o processo RECUSA
# subir se qualquer um continuar apontando para localhost, ou se não for
# https. A razão é o defeito mais silencioso do conjunto: o servidor sobe,
# responde a tudo, e quem descobre o erro é o destinatário, quando o link de
# redefinição de senha que chegou por email não abre na casa dele.

# Origens que o painel pode usar para falar com esta API, separadas por
# vírgula. Curinga é recusado em produção.
ORIGENS_PERMITIDAS=http://localhost:5173

# Endereço público desta API. Entra na URL de onde o aparelho busca a foto de
# vistoria quando o armazenamento é o local.
URL_PUBLICA=http://127.0.0.1:3333

# Endereço público do painel. Entra no link de redefinição de senha.
URL_PAINEL=http://localhost:5173

# ---------------------------------------------------------------------------
# Armazenamento de evidência
# ---------------------------------------------------------------------------
#
# Obrigatório em produção, todos os quatro. Sem eles a API guarda os bytes na
# memória do processo, o que em produção significaria perder toda foto de
# vistoria no primeiro reinício.
#
# O levantamento técnico recomenda Cloudflare R2 por causa do egress: o S3 em
# sa-east-1 cobra por GB que sai, e vistoria com foto sai muito.

# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_BALDE=dc360-evidencias
# Em R2 a região é sempre "auto". Na AWS, use a real (sa-east-1).
S3_REGIAO=auto
# S3_CHAVE_ID=
# S3_CHAVE_SECRETA=
