{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --workspaces --include-workspace-root --include=dev",
  "buildCommand": "npm run build --workspace @dc360/shared && npm run build --workspace @dc360/db && npm run build --workspace @dc360/campo && npm run build --workspace @dc360/web",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "build": {
    "env": {
      "VITE_API_URL": "https://defesa-civil.fly.dev",
      "VITE_GOOGLE_MAPS_CHAVE": ""
    }
  },
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(icone\\.svg|icone-192\\.png|icone-512\\.png|icone-mascaravel-512\\.png|apple-touch-icon\\.png|favicon\\.ico|og\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
